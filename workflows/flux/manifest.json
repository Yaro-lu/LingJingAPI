{
  "id": "flux",
  "name": "FLUX.2 轻量高清修复",
  "type": "image.image_to_image",
  "engine": "comfyui",
  "version": "2.0.0",
  "capability": "image_to_image",
  "model_group": "Flux2 Klein 4B",
  "enabled": true,
  "replaces_pending_conversion": true,
  "description": "用 FLUX.2 Klein 4B 重绘参考图细节，再以 Lanczos 放大 2 倍；适合 8 GB 显存。原始 FLUX.1 工作流保留在 frontend_workflow.json。",
  "input_schema": {
    "summary": "上传参考图片，填写希望保留或增强的细节；重绘后自动放大输出。",
    "required": [
      "image",
      "prompt"
    ],
    "optional": [
      "seed",
      "steps"
    ],
    "inputs": [
      {
        "name": "image",
        "type": "image",
        "label": "待修复图片",
        "required": true
      },
      {
        "name": "prompt",
        "type": "text",
        "label": "修复要求",
        "required": true,
        "default": "Enhance fine details and sharpness while preserving the original composition, subject, colors, and identity."
      },
      {
        "name": "seed",
        "type": "integer",
        "label": "随机种子",
        "required": false
      },
      {
        "name": "steps",
        "type": "integer",
        "label": "采样步数",
        "required": false,
        "minimum": 1,
        "maximum": 20
      }
    ]
  }
}
